# API 서버 환경변수 예시. 단계별 설명과 전체 표는 docs/deploy-env.md.
# 이 파일을 .env로 복사해 값을 채우고, 실제 비밀 값은 저장소에 올리지 마세요.
# (서버는 .env를 직접 읽지 않습니다. 호스트의 환경변수/시크릿으로 넣거나 `docker run --env-file`로 주세요.)

# 운영에서는 production. 로그인 설정이 없으면 부팅을 거부합니다.
NODE_ENV=production
# 호스트가 정해 주면 그 값을 따르세요. Docker 이미지 기본은 8080, 직접 실행 기본은 8787.
PORT=8080

# 웹 주소(CORS 허용, 한 개, 끝에 / 없이). 운영에서는 반드시 설정.
WEB_ORIGIN=https://vtt.example.com

# ── 로그인(Supabase) ─ 둘 중 하나 이상 ──
# 비대칭 서명 키(ES256/RS256) 프로젝트: 프로젝트 주소. JWKS로 검증합니다.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# 레거시 공유 비밀(HS256) 프로젝트. 절대 공개하지 마세요.
# SUPABASE_JWT_SECRET=
# aud 검사 값(기본 authenticated)
# SUPABASE_JWT_AUD=authenticated
# 개발용 인증(누구나 아무 사용자인 척 가능). production에서 정말 필요할 때만 1. 위 값이 있으면 무시됩니다.
# ALLOW_DEV_AUTH=

# ── 저장소 ──
# DATABASE_URL이 있으면 Postgres, 없으면 DATA_DIR 폴더(기본 ./data), DATA_DIR=memory면 메모리.
# Supabase는 Session pooler 주소를 권장합니다. 비밀번호가 들어 있으니 시크릿으로만 넣으세요.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Supabase는 자체 CA라서 보통 필요: no-verify(암호화만) 또는 verify(+DATABASE_CA_CERT)
# DATABASE_SSL=no-verify
# DATABASE_CA_CERT=
# DB_POOL_MAX=10
# DATA_DIR=/var/lib/coc-vtt

# 이미지·오디오를 R2/S3에 저장(없으면 DB 또는 DATA_DIR/images). 버킷은 비공개로 두세요.
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_BUCKET=coc-vtt-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_PREFIX=
# S3_FORCE_PATH_STYLE=1

# ── 그 밖 ──
# 프록시(로드밸런서) 겹 수. 프록시 뒤일 때만 1 이상. 직접 노출이면 비워 두세요.
TRUST_PROXY=1
# /health에 보일 버전(배포 커밋 등). 없으면 package.json 버전.
# APP_VERSION=
# LOG_LEVEL=info
# KP_AWAY_GRACE_MS=30000
# SHUTDOWN_TIMEOUT_MS=8000
