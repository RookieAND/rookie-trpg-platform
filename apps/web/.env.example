# 웹 환경변수 예시. Vercel 프로젝트의 Environment Variables에 넣습니다. 전체 설명은 docs/deploy-env.md.
# NEXT_PUBLIC_* 값은 빌드할 때 번들에 박히고 브라우저에 공개됩니다. 비밀 값을 넣지 마세요. 바꾸면 다시 배포해야 합니다.

# API 서버 주소(끝에 / 없이). 운영 빌드에서 비어 있으면 빌드가 실패합니다.
NEXT_PUBLIC_API_URL=https://api.vtt.example.com
# 비워 두면 API 주소에서 만듭니다(https → wss://api.vtt.example.com/ws). 따로 쓸 때만 지정.
# NEXT_PUBLIC_REALTIME_URL=
# Supabase 프로젝트 주소. 비우면 개발용 이름 로그인이 나옵니다.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase 공개(anon/publishable) 키. 만료된 토큰 자동 갱신용. service_role/secret 키는 절대 넣지 마세요.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
