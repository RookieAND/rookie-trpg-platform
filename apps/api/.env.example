# API 서버 환경변수 예시. 자세한 설명은 docs/deploy-env.md.
# 이 파일을 .env로 복사해 값을 채우고, 실제 비밀 값은 저장소에 올리지 마세요.

# 운영에서는 production. 시크릿이 없으면 부팅을 거부합니다.
NODE_ENV=production
PORT=8787

# 로그인 검증용 Supabase JWT 시크릿(필수). 절대 공개하지 마세요.
SUPABASE_JWT_SECRET=
# 개발용 인증(누구나 아무 사용자인 척 가능). production에서 정말 필요할 때만 1.
# ALLOW_DEV_AUTH=

# 저장소: DATABASE_URL이 있으면 Postgres, 없으면 DATA_DIR 폴더(기본 ./data), DATA_DIR=memory면 메모리.
DATABASE_URL=
# DATA_DIR=/var/lib/coc-vtt

# 웹 주소(CORS 허용). 운영에서는 반드시 설정.
WEB_ORIGIN=https://example.com

# 프록시(로드밸런서) 겹 수. 프록시 뒤일 때만 1 이상. 직접 노출이면 비워 두세요.
# TRUST_PROXY=1

# /health에 보일 버전(배포 커밋 등). 없으면 package.json 버전.
# APP_VERSION=
