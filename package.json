{
  "name": "coc-vtt",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "test": "pnpm -r --if-present test",
    "check": "pnpm typecheck && pnpm arch && pnpm test",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev:api": "pnpm --filter @coc-vtt/api dev",
    "dev:web": "pnpm --filter @coc-vtt/web dev",
    "e2e": "pnpm --filter @coc-vtt/web e2e",
    "arch": "node scripts/check-architecture.mjs",
    "import:scenario": "pnpm --filter @coc-vtt/api import:scenario"
  }
}
